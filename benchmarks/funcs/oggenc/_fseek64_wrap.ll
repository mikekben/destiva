declare i32 @fseek(ptr noundef, i64 noundef, i32 noundef) #0

; Function Attrs: nounwind uwtable
define hidden i32 @_fseek64_wrap(ptr noundef %f, i64 noundef %off, i32 noundef %whence) #1 {
entry:
  %retval = alloca i32, align 4
  %f.addr = alloca ptr, align 8
  %off.addr = alloca i64, align 8
  %whence.addr = alloca i32, align 4
  store ptr %f, ptr %f.addr, align 8
  store i64 %off, ptr %off.addr, align 8
  store i32 %whence, ptr %whence.addr, align 4
  %0 = load ptr, ptr %f.addr, align 8
  %cmp = icmp eq ptr %0, null
  br i1 %cmp, label %if.then, label %if.end

if.then:                                          ; preds = %entry
  store i32 -1, ptr %retval, align 4
  br label %return

if.end:                                           ; preds = %entry
  %1 = load ptr, ptr %f.addr, align 8
  %2 = load i64, ptr %off.addr, align 8
  %3 = load i32, ptr %whence.addr, align 4
  %call = call i32 @fseek(ptr noundef %1, i64 noundef %2, i32 noundef %3)
  store i32 %call, ptr %retval, align 4
  br label %return

return:                                           ; preds = %if.end, %if.then
  %4 = load i32, ptr %retval, align 4
  ret i32 %4
}

