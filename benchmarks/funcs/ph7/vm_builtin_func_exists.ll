  %call2 = call ptr @ph7_value_to_string(ptr noundef %5, ptr noundef %nLen)
  store ptr %call2, ptr %zName, align 8
  store i32 0, ptr %res, align 4
  %6 = load ptr, ptr %pVm, align 8
  %hFunction = getelementptr inbounds nuw %struct.ph7_vm, ptr %6, i32 0, i32 13
  %7 = load ptr, ptr %zName, align 8
  %8 = load i32, ptr %nLen, align 4
  %call3 = call ptr @SyHashGet(ptr noundef %hFunction, ptr noundef %7, i32 noundef %8)
  %cmp4 = icmp ne ptr %call3, null
  br i1 %cmp4, label %if.then7, label %lor.lhs.false

lor.lhs.false:                                    ; preds = %if.end
  %9 = load ptr, ptr %pVm, align 8
  %hHostFunction = getelementptr inbounds nuw %struct.ph7_vm, ptr %9, i32 0, i32 12
  %10 = load ptr, ptr %zName, align 8
  %11 = load i32, ptr %nLen, align 4
  %call5 = call ptr @SyHashGet(ptr noundef %hHostFunction, ptr noundef %10, i32 noundef %11)
  %cmp6 = icmp ne ptr %call5, null
  br i1 %cmp6, label %if.then7, label %if.end8

if.then7:                                         ; preds = %lor.lhs.false, %if.end
  store i32 1, ptr %res, align 4
  br label %if.end8

if.end8:                                          ; preds = %if.then7, %lor.lhs.false
  %12 = load ptr, ptr %pCtx.addr, align 8
  %13 = load i32, ptr %res, align 4
  %call9 = call i32 @ph7_result_bool(ptr noundef %12, i32 noundef %13)
  store i32 0, ptr %retval, align 4
  br label %return

return:                                           ; preds = %if.end8, %if.then
